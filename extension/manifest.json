{
  "manifest_version": 3,
  "name": "집찾기 수집기",
  "version": "0.5.0",
  "description": "네이버 부동산에서 보고 있는 매물 목록을 로컬 집찾기 사이트로 보냅니다.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["*://*.land.naver.com/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "집찾기 수집기" },
  "content_scripts": [
    { "matches": ["*://*.land.naver.com/*"], "js": ["inject.js"], "world": "MAIN", "run_at": "document_start", "all_frames": true },
    { "matches": ["*://*.land.naver.com/*"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": true }
  ]
}
